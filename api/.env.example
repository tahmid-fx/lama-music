# All values are optional — the server runs with safe defaults.
# Copy to .env and uncomment what you need: `bun --env-file=.env src/server.ts`

# Network binding. Use 127.0.0.1 locally; containers usually need 0.0.0.0.
PORT=8788
HOST=127.0.0.1

# MusicBrainz requires a descriptive User-Agent with contact details.
# Replace the URL with your own deployment URL or an email address.
MB_USER_AGENT=LamaMusicAPI/1.0.0 ( https://github.com/tahmid-fx/lama-music )

# MusicBrainz allows ~1 request/second per client; increase for nothing, lower to be safer.
MB_MIN_GAP_MS=1100

# Upstream timeouts, caching and per-IP rate limiting.
UPSTREAM_TIMEOUT_MS=9000
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# CORS: "*" for open public read-only use.
CORS_ORIGIN=*

# Override only for testing against a mock server.
# MUSICBRAINZ_BASE=https://musicbrainz.org/ws/2
# ITUNES_BASE=https://itunes.apple.com
